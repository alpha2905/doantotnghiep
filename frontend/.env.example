# ⚠️ KHÔNG commit file này nếu đã điền URL/key thật.
# Copy sang `.env` khi build local: copy frontend\.env.example frontend\.env
# Khi deploy Firebase Hosting: firebase hosting → hoặc
#   firebase functions:config (nếu dùng functions), hoặc khai báo trong CI:
#   VITE_API_URL=https://<backend-public-url> npm run build

# URL public của backend FastAPI (Render/Railway) — QUAN TRỌNG khi deploy:
# Local mặc định http://127.0.0.1:8000 (fallback trong App.jsx), production phải set:
VITE_API_URL=https://<ten-service-cua-ban>.onrender.com
