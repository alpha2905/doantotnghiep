# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=<app>
MONGO_DB_NAME=price_tracker

# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# Admin
ADMIN_EMAILS=admin@example.com

# CORS
FRONTEND_ORIGINS=https://datn-2905.web.app,https://your-frontend.web.app

# Firebase / Push Notification (FCM web)
GOOGLE_APPLICATION_CREDENTIALS=/app/backend/serviceAccountKey.json
# Hoặc dùng inline JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Expo Push (mobile)
EXPO_ACCESS_TOKEN=your-expo-access-token
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Server
PORT=8000
