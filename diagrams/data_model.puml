@startuml data_model
!theme plain
title Sơ Đồ Cấu Trúc Dữ Liệu MongoDB (Data Model Diagram)

' ===== DATABASE =====
package "Database: price_tracker" {

  ' ===== 8 COLLECTION SẢN PHẨM THEO SÀN =====
  package "Collection: fpt (FPT Shop)" {
    entity "fpt" as fpt {
      * _id: ObjectId <<PK>>
      --
      platform: String
      brand: String (iphone/samsung/oppo/xiaomi)
      name: String
      model_base: String
      price_number: Int
      price: String/Int (giá thô)
      image / image_url: String (URL)
      url / product_url: String <<UK>>
      rating: Float (0-5)
      sold: Int
      shop_reputation: Float (0-100)
      comments: Array[String]
      price_history: Array[Object]
        [{scraped_at: Date, price: Int}]
      forecast: Int (giá dự báo LSTM)
      last_crawl: Date
      last_scraped_at: Date
    }
  }

  package "Collection: tgdd (Thế Giới Di Động)" {
    entity "tgdd" as tgdd {
      * _id: ObjectId <<PK>>
      --
      platform: String
      brand: String
      name: String
      model_base: String
      price_number: Int
      price: String/Int
      image / image_url: String (URL)
      url / product_url: String <<UK>>
      rating: Float (0-5)
      sold: Int
      shop_reputation: Float (0-100)
      comments: Array[String]
      price_history: Array[Object]
        [{scraped_at: Date, price: Int}]
      forecast: Int
      last_crawl: Date
      last_scraped_at: Date
    }
  }

  package "Collection: cellphones (CellphoneS)" {
