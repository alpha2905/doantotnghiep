# AI Price Comparison - Environment Configuration
# Copy this file to .env and update the values

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

# Scraping Configuration
# TGDĐ URLs
TGDD_IPHONE_URL=https://www.thegioididong.com/dtdd-iphone
TGDD_SAMSUNG_URL=https://www.thegioididong.com/dtdd-samsung
TGDD_OPPO_URL=https://www.thegioididong.com/dtdd-oppo
TGDD_XIAOMI_URL=https://www.thegioididong.com/dtdd-xiaomi

# FPT Shop URLs
FPT_IPHONE_URL=https://fptshop.com.vn/dien-thoai/apple-iphone
FPT_SAMSUNG_URL=https://fptshop.com.vn/dien-thoai/samsung
FPT_OPPO_URL=https://fptshop.com.vn/dien-thoai/oppo
FPT_XIAOMI_URL=https://fptshop.com.vn/dien-thoai/xiaomi

# Điện Máy Xanh URLs
DMX_IPHONE_URL=https://www.dienmayxanh.com/dien-thoai-apple-iphone
DMX_SAMSUNG_URL=https://www.dienmayxanh.com/dien-thoai-samsung
DMX_OPPO_URL=https://www.dienmayxanh.com/dien-thoai-oppo
DMX_XIAOMI_URL=https://www.dienmayxanh.com/dien-thoai-xiaomi

# Scheduler Configuration
CRAWL_INTERVAL_HOURS=6
CRAWL_TIME=02:00

# Model Paths (relative to backend/)
LSTM_MODELS_PATH=models
PHOBERT_SENTIMENT_PATH=phobert_models/sentiment_classification/final_model
PHOBERT_ASPECT_PATH=phobert_models/aspect_classification/final_model

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Development
DEBUG=true
RELOAD=true
